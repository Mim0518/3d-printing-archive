# Copiar a /etc/printing-archive.env (permisos 640, dueño root:archivo).

# Solo escucha en el propio equipo; desde fuera se entra con `tailscale serve` (HTTPS).
ARCHIVO_DIRECCION=127.0.0.1:8080
ARCHIVO_BASE=/var/lib/printing-archive/archivo.db
ARCHIVO_ESTATICOS=/opt/printing-archive/dist
# 1 = la cookie de sesión solo viaja por HTTPS (correcto detrás de tailscale serve).
# Si entras por http://<ip>:8080 en la red de casa, pon 0 y ARCHIVO_DIRECCION=0.0.0.0:8080.
ARCHIVO_COOKIE_SEGURA=1
ARCHIVO_DIAS_SESION=30
RUST_LOG=info,tower_http=info
