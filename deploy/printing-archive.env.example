# Copiar a /etc/printing-archive.env (permisos 640, dueño root:archivo).

# Solo escucha en el propio equipo; desde fuera se entra con `tailscale serve` (HTTPS).
ARCHIVO_DIRECCION=127.0.0.1:8080
ARCHIVO_BASE=/var/lib/printing-archive/archivo.db
ARCHIVO_ESTATICOS=/opt/printing-archive/dist
# La colección (biblioteca principal).
ARCHIVO_BIBLIOTECA=/srv/3dp
# Miniaturas: caché (unos 1.5 GB para toda la colección), programa f3d y cuántas a la vez (por omisión, la mitad
# de los núcleos).
ARCHIVO_MINIATURAS=/var/lib/printing-archive/miniaturas
ARCHIVO_F3D=/usr/bin/f3d
ARCHIVO_PARALELO=3
# 1 = la cookie de sesión solo viaja por HTTPS (correcto detrás de tailscale serve).
# Si entras por http://<ip>:8080 en la red de casa, pon 0 y ARCHIVO_DIRECCION=0.0.0.0:8080.
ARCHIVO_COOKIE_SEGURA=1
# Almacenamiento frío: el programa rclone y su configuración (la del usuario archivo). La app no lee ese archivo:
# solo rclone lo usa, con los remotos que configuraste (DriveMemo:…).
ARCHIVO_RCLONE=/usr/bin/rclone
RCLONE_CONFIG=/var/lib/printing-archive/rclone.conf
ARCHIVO_DIAS_SESION=30
RUST_LOG=info,tower_http=info
